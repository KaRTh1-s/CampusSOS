# CampusSOS Environment Variables Template
# Copy this file to .env or .env.local for local development.
# NEVER commit .env files containing real keys or credentials.

# AWS Region (Default: ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# API Gateway Endpoint (Populated upon deployment or pointing to local mock)
VITE_API_BASE_URL=http://localhost:3001/api

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=CampusSOS-Reports

# S3 Evidence Bucket Configuration
S3_EVIDENCE_BUCKET=<bucket-name>

# Persistence Mode (dynamodb | memory)
PERSISTENCE_MODE=dynamodb

# AI Analysis Mode (mock | bedrock)
ANALYSIS_MODE=mock

# Bedrock Model Configuration
BEDROCK_MODEL_ID=global.anthropic.claude-fable-5-1
