# CampusSOS Environment Variables Template
# Copy this file to .env or .env.local for local development.
# NEVER commit .env files containing real keys or credentials.

# AWS Region (Default: ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# API Gateway Endpoint (Populated upon deployment or pointing to local mock)
VITE_API_BASE_URL=http://localhost:3001/api

# Bedrock Model Configuration
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=CampusSOS-Reports
