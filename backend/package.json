{
  "name": "campussos-backend",
  "version": "0.1.0",
  "description": "AWS Lambda-compatible serverless backend for CampusSOS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "npx tsx tests/backend.test.ts",
    "test:integration": "npx tsx tests/integration.test.ts",
    "test:dynamo": "npx tsx tests/dynamoDbIntegration.test.ts",
    "test:bedrock": "npx tsx tests/bedrockAnalysis.test.ts",
    "test:s3": "npx tsx tests/s3Evidence.test.ts",
    "test": "npx tsx tests/backend.test.ts && npx tsx tests/integration.test.ts",
    "start": "npx tsx src/localDevServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@types/aws-lambda": "^8.10.147"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
